---

import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
// HeroLayout.astro
// Modern minimal 3-column developer portfolio layout
// Styled with Tailwind CSS

interface Props {
  name?: string;
  role?: string;
  location?: string;
  imageUrl?: string;
  imageAlt?: string;
  bio?: string;
  skills?: string[];
  availableForWork?: boolean;
  email?: string;
  githubUrl?: string;
  linkedinUrl?: string;
  accentColor?: string;
}

const {
  name = "Lewis Barnes",
  role = "Full Stack Engineer",
  location = "Peterborough, UK",
  imageUrl = "https://media.licdn.com/dms/image/v2/D4E03AQHkVxUOFka9WQ/profile-displayphoto-crop_800_800/B4EZ3OlM3qGYAI-/0/1777287353354?e=1781136000&v=beta&t=YERj1u7Ht6HuIrKyzDvTjc4YHYvvTZq-I3HB1js9Z6M",
  imageAlt = "Lewis Barnes – Full Stack Engineer",
  bio = "Currently a Software Developer at Taylor Rose, building the tools that make legal operations run smoother. Working at the intersection of complex business logic and modern platforms, I turn legacy workflows into streamlined, user-centric products — shipping as part of a high-performance agile team.",
  skills = ["TypeScript", "React", "Node.js", "PostgreSQL", "Astro", "C#", "Salesforce"],
  availableForWork = false,
  email = "hello@lewisbarnes.dev",
  githubUrl = "https://github.com/lewisbarnes",
  linkedinUrl = "https://linkedin.com/in/lewiswbarnes",
  accentColor = "#e8ff6b"

} = Astro.props;
---
<Layout>
<section class="hero-layout w-full min-h-screen bg-[#0e0e0e] text-[#f0ece4] font-mono">
  <!-- Subtle grid background -->
  <div class="absolute inset-0 bg-[linear-gradient(rgba(240,236,228,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(240,236,228,0.03)_1px,transparent_1px)] bg-[size:80px_80px] pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 py-20 md:py-28">

    <!-- Top label -->
    <div class="flex items-center gap-3 mb-16">
      <span class="block w-8 h-px bg-[#f0ece4] opacity-40"></span>
      <p class="text-xs tracking-[0.3em] text-[#f0ece4] opacity-40 uppercase">Portfolio</p>
    </div>

    <!-- 3-column grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-[#f0ece4]/10">

      <!-- ─── COLUMN 1: Role & Identity ─── -->
      <div class="bg-[#0e0e0e] p-10 flex flex-col justify-between min-h-[520px] group relative overflow-hidden">
        <!-- Hover accent line -->
        <div class="absolute top-0 left-0 w-0 h-[2px] bg-[#e8ff6b] transition-all duration-500 group-hover:w-full"></div>

        <div>
          <!-- Status badge -->
          {availableForWork && (
            <div class="inline-flex items-center gap-2 border border-[#e8ff6b]/30 px-3 py-1.5 mb-10 rounded-sm">
              <span class="block w-1.5 h-1.5 rounded-full bg-[#e8ff6b] animate-pulse"></span>
              <span class="text-[10px] tracking-[0.25em] text-[#e8ff6b] uppercase">Available for work</span>
            </div>
          )}

          <!-- Role title -->
          <h1 class="text-4xl lg:text-5xl font-light leading-[1.1] tracking-tight mb-6 text-[#f0ece4]">
            Full Stack<br />
            <span class="text-[#e8ff6b]">Engineer</span>
          </h1>

          <!-- Location -->
          <div class="flex items-center gap-2 mb-10">
            <svg class="w-3 h-3 text-[#f0ece4]/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="text-xs text-[#f0ece4]/30 tracking-widest">{location}</span>
          </div>

          <!-- Divider -->
          <div class="w-full h-px bg-[#f0ece4]/10 mb-10"></div>

          <!-- Skills -->
          <div>
            <p class="text-[10px] tracking-[0.3em] text-[#f0ece4]/30 uppercase mb-4">Tech Stack</p>
            <div class="flex flex-wrap gap-2">
              {skills.map((skill) => (
                <span class="text-xs px-2.5 py-1 border border-[#f0ece4]/10 text-[#f0ece4]/50 hover:border-[#e8ff6b]/40 hover:text-[#e8ff6b] transition-colors duration-200 cursor-default">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Contact links -->
        <div class="flex items-center gap-5 pt-10">
          <span class="w-3 h-px bg-[#f0ece4]/20"></span>
          <a href={githubUrl} target="_blank" rel="noopener" class="text-[10px] tracking-[0.2em] text-[#f0ece4]/30 hover:text-[#e8ff6b] transition-colors uppercase">GitHub</a>
          <span class="w-3 h-px bg-[#f0ece4]/20"></span>
          <a href={linkedinUrl} target="_blank" rel="noopener" class="text-[10px] tracking-[0.2em] text-[#f0ece4]/30 hover:text-[#e8ff6b] transition-colors uppercase">LinkedIn</a>
        </div>
      </div>

      <!-- ─── COLUMN 2: Developer Image ─── -->
      <div class="bg-[#0e0e0e] relative overflow-hidden min-h-[520px] group">
        <!-- Image fills column -->
        <img
          src={imageUrl}
          alt={imageAlt}
          class="absolute inset-0 w-full h-full object-cover object-center grayscale transition-all duration-700 group-hover:grayscale-0 group-hover:scale-[1.02]"
        />

        <!-- Overlay gradient -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#0e0e0e] via-[#0e0e0e]/20 to-transparent"></div>

        <!-- Name label at bottom -->
        <div class="absolute bottom-0 left-0 right-0 p-10">
          <p class="text-[10px] tracking-[0.3em] text-[#f0ece4]/40 uppercase mb-1">Developer</p>
          <h2 class="text-2xl font-light text-[#f0ece4] tracking-tight">{name}</h2>
        </div>

        <!-- Hover color hint -->
        <div class="absolute top-6 right-6 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
          <span class="text-[10px] tracking-[0.2em] text-[#e8ff6b]/70 uppercase">In colour</span>
        </div>
      </div>

      <!-- ─── COLUMN 3: Bio & Ethos ─── -->
      <div class="bg-[#0e0e0e] p-10 flex flex-col justify-between min-h-[520px] group relative overflow-hidden">
        <!-- Hover accent line -->
        <div class="absolute top-0 right-0 w-0 h-[2px] bg-[#e8ff6b] transition-all duration-500 group-hover:w-full origin-right"></div>

        <div>
          <!-- Section label -->
          <p class="text-[10px] tracking-[0.3em] text-[#f0ece4]/30 uppercase mb-10">About</p>

          <!-- Bio -->
          <p class="text-[#f0ece4]/70 text-base leading-relaxed font-light mb-8">
            {bio}
          </p>

          <!-- Divider -->
          <div class="w-full h-px bg-[#f0ece4]/10 mb-8"></div>
      </div>

    </div>
  </div>
</section>
</Layout>