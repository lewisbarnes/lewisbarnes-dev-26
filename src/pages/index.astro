---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import portrait from "../assets/lewis_barnes.png";
import bioRaw from "../bio.txt?raw";

const name = "Lewis Barnes";
const role = "Full Stack Engineer";
const location = "Peterborough, UK";
const bio = bioRaw.trim();
const availableForWork = true;
const githubUrl = "https://github.com/lewisbarnes";
const linkedinUrl = "https://linkedin.com/in/lewiswbarnes";

const skills = [
  { name: "TypeScript", color: "bg-sky" },
  { name: "React", color: "bg-mint" },
  { name: "Node.js", color: "bg-sun" },
  { name: "PostgreSQL", color: "bg-tangerine" },
  { name: "Astro", color: "bg-punch text-white" },
  { name: "C#", color: "bg-grape text-white" },
  { name: "Salesforce", color: "bg-sky" },
];

const stats = [
  { value: "2020", label: "Building LegalTech since", color: "bg-sun" },
  { value: "3", label: "Law firms powered", color: "bg-mint" },
  { value: "1,000+", label: "Consultant lawyers", color: "bg-punch text-white" },
];

const firms = ["Taylor Rose", "Kingsley Wood", "FDR Law", "AIIC Group Services"];
---
<Layout title={`${name} | ${role}`}>
  <!-- Colour blobs -->
  <div aria-hidden="true" class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
    <div class="absolute -top-32 -left-24 h-96 w-96 rounded-full bg-punch/40 blur-3xl animate-float"></div>
    <div class="absolute top-1/3 -right-32 h-112 w-md rounded-full bg-sky/40 blur-3xl animate-float [animation-delay:-3s]"></div>
    <div class="absolute -bottom-40 left-1/4 h-104 w-104 rounded-full bg-sun/50 blur-3xl animate-float [animation-delay:-5s]"></div>
  </div>

  <main class="relative z-10 mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-16">

    <!-- Header bar -->
    <header class="mb-12 flex flex-wrap items-center justify-between gap-4">
      <a href="/" class="font-display text-xl font-extrabold tracking-tight">
        lewis<span class="text-punch">.</span>dev
      </a>
      <nav class="flex gap-3">
        <a href={githubUrl} target="_blank" rel="noopener" class="rounded-full border-2 border-ink bg-white px-4 py-1.5 text-sm font-semibold shadow-pop-sm transition hover:-translate-y-0.5 hover:bg-sun">GitHub</a>
        <a href={linkedinUrl} target="_blank" rel="noopener" class="rounded-full border-2 border-ink bg-white px-4 py-1.5 text-sm font-semibold shadow-pop-sm transition hover:-translate-y-0.5 hover:bg-sky">LinkedIn</a>
      </nav>
    </header>

    <!-- Hero -->
    <section class="grid items-center gap-12 md:grid-cols-[1.2fr_1fr]">
      <div>
        {availableForWork && (
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border-2 border-ink bg-mint px-4 py-1.5 text-xs font-semibold uppercase tracking-widest shadow-pop-sm">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-ink opacity-60"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-ink"></span>
            </span>
            Available for work
          </div>
        )}

        <h1 class="font-display text-5xl font-extrabold leading-[0.95] tracking-tight sm:text-7xl">
          Hi, I'm
          <span class="block bg-linear-to-r from-punch via-tangerine to-grape bg-clip-text text-transparent">
            Lewis Barnes
          </span>
        </h1>

        <p class="mt-6 flex flex-wrap items-center gap-3 font-display text-xl font-semibold sm:text-2xl">
          <span class="rounded-lg bg-grape px-3 py-1 text-white -rotate-2 inline-block">{role}</span>
          <span class="text-ink/70">in</span>
          <span class="rounded-lg bg-sun px-3 py-1 rotate-1 inline-block">LegalTech</span>
        </p>

        <p class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-ink/70">
          <svg class="h-4 w-4 text-punch" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          {location}
        </p>
      </div>

      <!-- Portrait -->
      <div class="relative mx-auto w-full max-w-sm">
        <div aria-hidden="true" class="absolute -inset-4 rounded-[2.5rem] bg-[conic-gradient(from_0deg,var(--color-punch),var(--color-sun),var(--color-mint),var(--color-sky),var(--color-grape),var(--color-punch))] animate-spin-slow opacity-90 blur-sm"></div>
        <div class="relative rotate-2 overflow-hidden rounded-4xl border-4 border-ink bg-white shadow-pop transition duration-500 hover:rotate-0">
          <Image
            src={portrait}
            alt={`${name}, ${role}`}
            width={800}
            widths={[400, 800]}
            sizes="(min-width: 768px) 384px, 90vw"
            class="aspect-4/5 w-full object-cover"
            loading="eager"
          />
        </div>
        <div class="absolute -bottom-5 -left-5 -rotate-6 rounded-2xl border-2 border-ink bg-sun px-4 py-2 font-display text-lg font-extrabold shadow-pop-sm">
          👋 Hello!
        </div>
      </div>
    </section>

    <!-- Bio -->
    <section class="mt-20">
      <div class="relative rounded-4xl border-4 border-ink bg-white p-8 shadow-pop sm:p-12">
        <span class="absolute -top-5 left-8 rounded-full border-2 border-ink bg-punch px-4 py-1 text-xs font-bold uppercase tracking-widest text-white">
          About me
        </span>
        <p class="font-display text-2xl font-semibold leading-snug sm:text-3xl">
          {bio}
        </p>

        <div class="mt-8 flex flex-wrap gap-2">
          {firms.map((firm, i) => (
            <span class:list={[
              "rounded-full border-2 border-ink px-3 py-1 text-sm font-semibold",
              ["bg-sky/30", "bg-mint/30", "bg-tangerine/30", "bg-grape/20"][i % 4],
            ]}>
              {firm}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="mt-10 grid gap-6 sm:grid-cols-3">
      {stats.map((stat, i) => (
        <div class:list={[
          "rounded-3xl border-4 border-ink p-6 shadow-pop transition hover:-translate-y-1",
          stat.color,
          ["-rotate-1", "rotate-1", "-rotate-1"][i],
        ]}>
          <p class="font-display text-5xl font-extrabold tracking-tight">{stat.value}</p>
          <p class="mt-2 text-sm font-semibold uppercase tracking-wider opacity-80">{stat.label}</p>
        </div>
      ))}
    </section>

    <!-- Skills -->
    <section class="mt-16">
      <h2 class="font-display text-3xl font-extrabold tracking-tight">
        Tech I <span class="text-grape underline decoration-sun decoration-8 underline-offset-4">love</span> working with
      </h2>
      <ul class="mt-6 flex flex-wrap gap-3">
        {skills.map((skill) => (
          <li class:list={[
            "cursor-default rounded-xl border-2 border-ink px-4 py-2 font-semibold shadow-pop-sm transition hover:-translate-y-1 hover:rotate-2",
            skill.color,
          ]}>
            {skill.name}
          </li>
        ))}
      </ul>
    </section>

    <!-- Footer -->
    <footer class="mt-24 flex flex-col items-center gap-4 border-t-4 border-dashed border-ink/20 pt-10 text-center">
      <p class="font-display text-2xl font-extrabold">Let's connect ✨</p>
      <div class="flex gap-3">
        <a href={githubUrl} target="_blank" rel="noopener" class="rounded-full border-2 border-ink bg-grape px-5 py-2 font-semibold text-white shadow-pop-sm transition hover:-translate-y-0.5">GitHub</a>
        <a href={linkedinUrl} target="_blank" rel="noopener" class="rounded-full border-2 border-ink bg-sky px-5 py-2 font-semibold shadow-pop-sm transition hover:-translate-y-0.5">LinkedIn</a>
      </div>
      <p class="mt-6 text-xs text-ink/50">© {new Date().getFullYear()} {name}</p>
    </footer>
  </main>
</Layout>
